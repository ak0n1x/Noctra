power *= -1

height_value = np.mean(power) + np.std(power)

peaks, properties = find_peaks(
    power,
    height=height_value,
    distance=20
)

print("Height utilisé :", height_value)
print("Nombre de pics :", len(peaks))
print("Premiers pics :", peaks[:20])

diffs = np.diff(peaks)

print("diff entre pics :", diffs[:60])
print("min =", np.min(diffs))
print("max =", np.max(diffs))
print("moyenne =", np.mean(diffs))
print("percentiles =", np.percentile(diffs, [50, 90, 95, 98, 99]))

gap_threshold = 200

segments = []
current_count = 1

for gap in diffs:
    if gap > gap_threshold:
        segments.append(current_count)
        current_count = 1
    else:
        current_count += 1

segments.append(current_count)

print("Nombre de segments/bits détectés :", len(segments))
print("Pics par segment, 40 premiers :", segments[:40])

bits = ""

for count in segments:
    if count >= 13:
        bits += "1"
    else:
        bits += "0"

print("Nombre de bits :", len(bits))
print("Début binaire :", bits[:24])
print("Début attendu :", "100000000000011011110010")

bits_1024 = bits[:1024]

rsa_key = hex(int(bits_1024, 2))[2:].zfill(256)

print("Début hex :", rsa_key[:6])
print("Longueur hex :", len(rsa_key))
print("Clé hex :", rsa_key)

check_key(rsa_key)
